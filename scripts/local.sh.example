#!/usr/bin/env bash
# Copy to scripts/local.sh (git-ignored) and edit. Sourced before scripts/config.sh: what you set here beats the
# environment, and the environment beats the defaults.
# The addresses below are documentation placeholders (RFC 5737): replace every one.

# Rank order. Rank 0 serves the API and is where you run ./start.sh ("local"); ranks 1-3 are reached over ssh.
NODES=(local user@worker1 user@worker2 user@worker3)

# The IPv4 each node holds on the CX7 fabric, one per NODES entry, same order. All four share one subnet.
FABRIC_IPS=(192.0.2.1 192.0.2.2 192.0.2.3 192.0.2.4)

# Weights: the same absolute path on every node (a local copy on each, or one NFS export mounted read-only).
MODEL_DIR=/path/to/ERNIE-5.5-Flash-Preview
CACHE_DIR=/path/to/ernie55-cache

# Optional. Clients that already point at a fixed model name can keep it:
#SERVED_NAME=ERNIE-5.5-Flash-Preview
#BIND_HOST=0.0.0.0        # only on a network you trust: the API has no authentication
#FABRIC_IFACE=enp1s0f1np1
#RDMA_HCAS=rocep1s0f1,roceP2p1s0f1
